# Copy to `.env` (same directory as docker-compose.yml) before running
# `docker compose up -d --build`. Docker Compose reads `.env` automatically
# for ${VAR} substitution in docker-compose.yml.

# MySQL container credentials (also used to build the app's DATABASE_URL).
DB_DATABASE=coibot
DB_USERNAME=coibot
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

# NextAuth (Auth.js v5). Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# App-level symmetric encryption key for settings (32 bytes, base64).
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=change-me-32-byte-base64-key

# Optional fallback Gemini API key (Settings page value takes precedence)
GEMINI_API_KEY=

# Comma-separated list of origins allowed to call /api/chatbot/* from the
# browser (the chat-bot widget). Use "*" to allow all.
CHATBOT_CORS_ORIGINS=*

# First admin user, created by the seed step (run once):
#   docker compose exec web npm run db:seed
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
