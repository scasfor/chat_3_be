# Database (Microsoft SQL Server / Azure SQL)
# Local Docker example (trustServerCertificate=true for self-signed container certs):
DATABASE_URL="sqlserver://localhost:1433;database=coibot;user=sa;password=Your_strong_Password123;encrypt=true;trustServerCertificate=true"
# Azure SQL example (encrypt=true; usually trustServerCertificate=false):
# DATABASE_URL="sqlserver://your-server.database.windows.net:1433;database=coibot;user=coibot;password=...;encrypt=true;trustServerCertificate=false"

# NextAuth (Auth.js v5). Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Seed credentials used by `npm run db:seed` to create the first admin user.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please"

# App-level symmetric encryption key for settings (32 bytes, base64), used to
# encrypt values such as the Gemini API key before storing them in the DB.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY="change-me-32-byte-base64-key"

# Optional fallback Gemini API key (Settings page value takes precedence)
GEMINI_API_KEY=""

# Comma-separated list of origins allowed to call the public /api/chatbot/*
# endpoints from the browser (the chat-bot widget). Use "*" to allow all.
CHATBOT_CORS_ORIGINS="*"

# Legacy Laravel MySQL database connection, used only by
# `npm run migrate:legacy-data` to copy data into the new SQL Server schema
# (DATABASE_URL above). Not needed after cutover.
LEGACY_DB_HOST="127.0.0.1"
LEGACY_DB_PORT="3306"
LEGACY_DB_DATABASE="coibot"
LEGACY_DB_USERNAME="root"
LEGACY_DB_PASSWORD=""
